[Unit]
Description=AppGap consistent SQLite backup

[Service]
Type=oneshot
User=appgap
Group=appgap
WorkingDirectory=/opt/appgap/current
EnvironmentFile=/etc/appgap.env
ExecStart=/bin/bash deploy/backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/appgap /var/backups/appgap
MemoryMax=192M
Nice=15
