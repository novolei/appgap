[Unit]
Description=AppGap daily Steam regional opportunity snapshot
After=network-online.target

[Service]
Type=oneshot
User=appgap
Group=appgap
WorkingDirectory=/opt/appgap/current
ExecStart=/usr/bin/python3 scripts/steam/collect.py --directory /var/lib/appgap/steam
TimeoutStartSec=55min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/appgap
MemoryMax=768M
CPUQuota=100%
Nice=15

